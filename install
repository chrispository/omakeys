#!/bin/bash

# Installs OmaKeys from a git clone: copies the plugin into
# ~/.config/omarchy/plugins/, installs the `omakeys` CLI, enables the
# plugin, and binds SUPER + A. All of the work happens in ./setup, which
# is also the only step needed after `omarchy plugin add`.

set -euo pipefail

exec "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/setup"
