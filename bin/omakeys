#!/bin/bash

# Manage API keys stored in gnome-keyring under attributes service=api-keys,
# name=<key name>. The Super+A selector (chrispository.omakeys shell plugin)
# reads the same entries.

set -euo pipefail

SERVICE=api-keys

usage() {
  cat <<'EOF'
Usage:
  omakeys add <name>       Store a key (prompts for the value, or pipe it in)
  omakeys list             List key names
  omakeys copy <name>      Copy a key to the clipboard (sensitive, trimmed)
  omakeys show <name>      Print a key to stdout
  omakeys rm <name>        Delete a key
  omakeys mv <old> <new>   Rename a key
  omakeys import <file|->  Bulk import "NAME=VALUE" or "NAME<whitespace>VALUE"
                           lines (blank lines and #comments skipped), then
                           offer to shred the file. "-" reads stdin.
  omakeys export           Print every key as NAME=VALUE on stdout
    --encrypt <file>       ...into a gpg passphrase-encrypted file instead
    --yes                  Skip the plaintext confirmation
EOF
  exit 1
}

require_name() {
  [[ -n ${1:-} ]] || usage
}

store_key() {
  local name=$1 value=$2
  printf '%s' "$value" | secret-tool store --label="$name" service "$SERVICE" name "$name"
}

# secret-tool search prints matched items on stderr, not stdout
list_names() {
  secret-tool search --all service "$SERVICE" 2>&1 | sed -n 's/^attribute\.name = //p' | sort
}

# One NAME=VALUE line per key. Anything that wouldn't survive a round-trip
# through import is skipped loudly rather than written out broken: a name
# holding "=" would re-import split at the wrong place, and a multi-line
# value can't be represented at all in a line-oriented format.
emit_export() {
  local name value skipped=0 count=0
  while IFS= read -r name; do
    [[ -n $name ]] || continue
    if [[ $name == *=* ]]; then
      echo "Skipping '$name': the name contains '=', which import can't round-trip." >&2
      skipped=$((skipped + 1))
      continue
    fi
    value=$(secret-tool lookup service "$SERVICE" name "$name")
    if [[ $value == *$'\n'* ]]; then
      echo "Skipping '$name': the value spans multiple lines." >&2
      skipped=$((skipped + 1))
      continue
    fi
    printf '%s=%s\n' "$name" "$value"
    count=$((count + 1))
  done < <(list_names)
  if ((skipped)); then
    echo "Exported $count key(s), skipped $skipped." >&2
  else
    echo "Exported $count key(s)." >&2
  fi
}

# Reads NAME=VALUE / NAME<whitespace>VALUE lines from stdin. Splitting on the
# first "=" is what lets a name contain spaces ("Cloudflare R2 Endpoint=..."),
# so the whitespace form only has to cover lines with no "=" at all.
import_lines() {
  local line name value
  count=0
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line#"${line%%[![:space:]]*}"}
    line=${line%"${line##*[![:space:]]}"}
    [[ -z $line || $line == \#* ]] && continue
    if [[ $line == *=* ]]; then
      name=${line%%=*}
      value=${line#*=}
      name=${name%"${name##*[![:space:]]}"}
    elif [[ $line =~ ^([^[:space:]]+)[[:space:]]+(.+)$ ]]; then
      name=${BASH_REMATCH[1]} value=${BASH_REMATCH[2]}
    else
      echo "Skipping unparseable line: ${line%%[= ]*}…" >&2
      continue
    fi
    if [[ -z $name || -z $value ]]; then
      echo "Skipping line with an empty name or value." >&2
      continue
    fi
    store_key "$name" "$value"
    echo "Stored '$name'."
    count=$((count + 1))
  done
}

# gnome-keyring attribute matching is a literal string comparison (not a
# security boundary, just exact-match), so "deepseek_1" won't find a key
# stored as "DEEPSEEK_1". Resolve case-insensitively against the real stored
# names so the CLI doesn't force users to type the exact original casing.
resolve_name() {
  local query=$1
  if secret-tool lookup service "$SERVICE" name "$query" >/dev/null 2>&1; then
    printf '%s' "$query"
    return 0
  fi

  local all matches=()
  all=$(secret-tool search --all service "$SERVICE" 2>&1 | sed -n 's/^attribute\.name = //p')
  while IFS= read -r n; do
    [[ -n $n && ${n,,} == "${query,,}" ]] && matches+=("$n")
  done <<<"$all"

  case ${#matches[@]} in
  0) return 1 ;;
  1)
    printf '%s' "${matches[0]}"
    return 0
    ;;
  *)
    echo "'$query' matches multiple keys differing only by case: ${matches[*]}" >&2
    return 2
    ;;
  esac
}

cmd=${1:-}
case "$cmd" in
add)
  require_name "${2:-}"
  if [[ -t 0 ]]; then
    read -rsp "Value for '$2': " value
    echo
  else
    value=$(cat)
  fi
  # Trailing newlines from a sloppy paste would silently break the key later.
  value=${value%$'\n'}
  [[ -n $value ]] || { echo "Empty value; nothing stored." >&2; exit 1; }
  store_key "$2" "$value"
  echo "Stored '$2'."
  ;;
list)
  list_names
  ;;
copy)
  require_name "${2:-}"
  resolved=$(resolve_name "$2") || { echo "No such key: '$2'" >&2; exit 1; }
  secret-tool lookup service "$SERVICE" name "$resolved" | wl-copy --trim-newline --sensitive
  echo "Copied '$resolved' to clipboard."
  ;;
show)
  require_name "${2:-}"
  resolved=$(resolve_name "$2") || { echo "No such key: '$2'" >&2; exit 1; }
  secret-tool lookup service "$SERVICE" name "$resolved"
  echo
  ;;
rm)
  require_name "${2:-}"
  resolved=$(resolve_name "$2") || { echo "No such key: '$2'" >&2; exit 1; }
  secret-tool clear service "$SERVICE" name "$resolved"
  echo "Deleted '$resolved'."
  ;;
mv)
  old=${2:-} new=${3:-}
  [[ -n $old && -n $new ]] || { echo "Usage: omakeys mv <old> <new>" >&2; exit 1; }

  resolved_old=$(resolve_name "$old") || { echo "No such key: '$old'" >&2; exit 1; }
  [[ $resolved_old != "$new" ]] || { echo "Names are identical; nothing to do." >&2; exit 1; }
  value=$(secret-tool lookup service "$SERVICE" name "$resolved_old")

  # secret-tool has no rename primitive: read the value under the old name,
  # store it under the new one, then clear the old entry. A resolve_name hit
  # that's just the entry being renamed (a pure case change) isn't a real
  # collision, so it skips the prompt; an ambiguous hit (multiple existing
  # case-variants of the target name) refuses to guess rather than silently
  # creating a third variant.
  new_status=0
  resolved_new=$(resolve_name "$new") || new_status=$?
  if [[ $new_status -eq 2 ]]; then
    exit 1
  elif [[ $new_status -eq 0 && $resolved_new != "$resolved_old" ]]; then
    read -rp "'$resolved_new' already exists — overwrite it? [y/N] " answer
    [[ $answer == [Yy]* ]] || { echo "Aborted." >&2; exit 1; }
  fi

  store_key "$new" "$value"
  secret-tool clear service "$SERVICE" name "$resolved_old"
  echo "Renamed '$resolved_old' -> '$new'."
  ;;
import)
  file=${2:-}
  [[ -n $file ]] || { echo "Usage: omakeys import <file|->" >&2; exit 1; }
  if [[ $file == "-" ]]; then
    import_lines
  else
    [[ -f $file ]] || { echo "No such file: $file" >&2; exit 1; }
    import_lines <"$file"
  fi
  echo "Imported $count key(s)."
  # Only a real file can be shredded, and only a tty can be asked. Reading
  # stdin leaves nothing on disk to clean up.
  if [[ $file != "-" && -t 0 && $count -gt 0 ]]; then
    read -rp "Shred and delete '$file' now? [Y/n] " answer
    if [[ -z $answer || $answer == [Yy]* ]]; then
      shred -u "$file"
      echo "Shredded '$file'."
    else
      echo "Left '$file' in place — it holds plaintext keys, delete it when done."
    fi
  fi
  ;;
export)
  shift
  encrypt_to="" assume_yes=0
  while (($# > 0)); do
    case "$1" in
    --encrypt)
      encrypt_to=${2:-}
      [[ -n $encrypt_to ]] || { echo "--encrypt needs a file path" >&2; exit 1; }
      shift 2
      ;;
    --yes | -y)
      assume_yes=1
      shift
      ;;
    *) echo "Unknown export option: $1" >&2; exit 1 ;;
    esac
  done

  if [[ -n $encrypt_to ]]; then
    command -v gpg >/dev/null || { echo "gpg is required for --encrypt" >&2; exit 1; }
    [[ ! -e $encrypt_to ]] || { echo "'$encrypt_to' already exists; refusing to overwrite." >&2; exit 1; }
    # 077 so the file is never briefly world-readable, even though gpg's own
    # default is usually 600. pipefail makes a failed export abort the write.
    (
      umask 077
      emit_export | gpg --quiet --symmetric --cipher-algo AES256 --output "$encrypt_to"
    )
    echo "Wrote encrypted export to '$encrypt_to'." >&2
    echo "Restore it with:  gpg -d '$encrypt_to' | omakeys import -" >&2
  else
    if ((!assume_yes)) && [[ -t 0 ]]; then
      echo "This prints every stored key in plaintext." >&2
      read -rp "Continue? [y/N] " answer
      [[ $answer == [Yy]* ]] || { echo "Aborted." >&2; exit 1; }
    fi
    emit_export
  fi
  ;;
*)
  usage
  ;;
esac
