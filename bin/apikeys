#!/bin/bash

# Manage API keys stored in gnome-keyring under attributes service=api-keys,
# name=<key name>. The Super+A selector (chris.apikeys shell plugin) reads
# the same entries.

set -euo pipefail

SERVICE=api-keys

usage() {
  cat <<'EOF'
Usage:
  apikeys add <name>       Store a key (prompts for the value, or pipe it in)
  apikeys list             List key names
  apikeys copy <name>      Copy a key to the clipboard (sensitive, trimmed)
  apikeys show <name>      Print a key to stdout
  apikeys rm <name>        Delete a key
  apikeys mv <old> <new>   Rename a key
  apikeys import <file>    Bulk import "NAME=VALUE" or "NAME<whitespace>VALUE"
                           lines (blank lines and #comments skipped), then
                           offer to shred the file
EOF
  exit 1
}

require_name() {
  [[ -n ${1:-} ]] || usage
}

store_key() {
  local name=$1 value=$2
  printf '%s' "$value" | secret-tool store --label="$name" service "$SERVICE" name "$name"
}

# gnome-keyring attribute matching is a literal string comparison (not a
# security boundary, just exact-match), so "deepseek_1" won't find a key
# stored as "DEEPSEEK_1". Resolve case-insensitively against the real stored
# names so the CLI doesn't force users to type the exact original casing.
resolve_name() {
  local query=$1
  if secret-tool lookup service "$SERVICE" name "$query" >/dev/null 2>&1; then
    printf '%s' "$query"
    return 0
  fi

  local all matches=()
  all=$(secret-tool search --all service "$SERVICE" 2>&1 | sed -n 's/^attribute\.name = //p')
  while IFS= read -r n; do
    [[ -n $n && ${n,,} == "${query,,}" ]] && matches+=("$n")
  done <<<"$all"

  case ${#matches[@]} in
  0) return 1 ;;
  1)
    printf '%s' "${matches[0]}"
    return 0
    ;;
  *)
    echo "'$query' matches multiple keys differing only by case: ${matches[*]}" >&2
    return 2
    ;;
  esac
}

cmd=${1:-}
case "$cmd" in
add)
  require_name "${2:-}"
  if [[ -t 0 ]]; then
    read -rsp "Value for '$2': " value
    echo
  else
    value=$(cat)
  fi
  # Trailing newlines from a sloppy paste would silently break the key later.
  value=${value%$'\n'}
  [[ -n $value ]] || { echo "Empty value; nothing stored." >&2; exit 1; }
  store_key "$2" "$value"
  echo "Stored '$2'."
  ;;
list)
  # secret-tool search prints matched items on stderr, not stdout
  secret-tool search --all service "$SERVICE" 2>&1 | sed -n 's/^attribute\.name = //p' | sort
  ;;
copy)
  require_name "${2:-}"
  resolved=$(resolve_name "$2") || { echo "No such key: '$2'" >&2; exit 1; }
  secret-tool lookup service "$SERVICE" name "$resolved" | wl-copy --trim-newline --sensitive
  echo "Copied '$resolved' to clipboard."
  ;;
show)
  require_name "${2:-}"
  resolved=$(resolve_name "$2") || { echo "No such key: '$2'" >&2; exit 1; }
  secret-tool lookup service "$SERVICE" name "$resolved"
  echo
  ;;
rm)
  require_name "${2:-}"
  resolved=$(resolve_name "$2") || { echo "No such key: '$2'" >&2; exit 1; }
  secret-tool clear service "$SERVICE" name "$resolved"
  echo "Deleted '$resolved'."
  ;;
mv)
  old=${2:-} new=${3:-}
  [[ -n $old && -n $new ]] || { echo "Usage: apikeys mv <old> <new>" >&2; exit 1; }

  resolved_old=$(resolve_name "$old") || { echo "No such key: '$old'" >&2; exit 1; }
  [[ $resolved_old != "$new" ]] || { echo "Names are identical; nothing to do." >&2; exit 1; }
  value=$(secret-tool lookup service "$SERVICE" name "$resolved_old")

  # secret-tool has no rename primitive: read the value under the old name,
  # store it under the new one, then clear the old entry. A resolve_name hit
  # that's just the entry being renamed (a pure case change) isn't a real
  # collision, so it skips the prompt; an ambiguous hit (multiple existing
  # case-variants of the target name) refuses to guess rather than silently
  # creating a third variant.
  new_status=0
  resolved_new=$(resolve_name "$new") || new_status=$?
  if [[ $new_status -eq 2 ]]; then
    exit 1
  elif [[ $new_status -eq 0 && $resolved_new != "$resolved_old" ]]; then
    read -rp "'$resolved_new' already exists — overwrite it? [y/N] " answer
    [[ $answer == [Yy]* ]] || { echo "Aborted." >&2; exit 1; }
  fi

  store_key "$new" "$value"
  secret-tool clear service "$SERVICE" name "$resolved_old"
  echo "Renamed '$resolved_old' -> '$new'."
  ;;
import)
  file=${2:-}
  [[ -f $file ]] || { echo "No such file: $file" >&2; exit 1; }
  count=0
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line#"${line%%[![:space:]]*}"}
    line=${line%"${line##*[![:space:]]}"}
    [[ -z $line || $line == \#* ]] && continue
    if [[ $line =~ ^([^=[:space:]]+)=(.+)$ ]]; then
      name=${BASH_REMATCH[1]} value=${BASH_REMATCH[2]}
    elif [[ $line =~ ^([^[:space:]]+)[[:space:]]+(.+)$ ]]; then
      name=${BASH_REMATCH[1]} value=${BASH_REMATCH[2]}
    else
      echo "Skipping unparseable line: ${line%%[= ]*}…" >&2
      continue
    fi
    store_key "$name" "$value"
    echo "Stored '$name'."
    count=$((count + 1))
  done <"$file"
  echo "Imported $count key(s)."
  if [[ -t 0 && $count -gt 0 ]]; then
    read -rp "Shred and delete '$file' now? [Y/n] " answer
    if [[ -z $answer || $answer == [Yy]* ]]; then
      shred -u "$file"
      echo "Shredded '$file'."
    else
      echo "Left '$file' in place — it holds plaintext keys, delete it when done."
    fi
  fi
  ;;
*)
  usage
  ;;
esac
